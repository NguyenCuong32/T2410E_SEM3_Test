<!DOCTYPE html>
<html>
<head>
    <title>Product List</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
</head>
<body class="p-4">

<h2 class="mb-4">Danh sách sản phẩm</h2>

<a href="/add" class="btn btn-primary mb-3">+ Add New Product</a>

<table class="table table-bordered">
    <thead class="table-dark">
        <tr>
            <th>Code</th>
            <th>Name</th>
            <th>Date</th>
            <th>Price</th>
            <th>Qty</th>
            <th>Store</th>
            <th>Action</th>
        </tr>
    </thead>

    <tbody>
        <% products.forEach(p => { %>
            <tr>
                <td><%= p.ProductCode %></td>
                <td><%= p.ProductName %></td>
                <td><%= p.ProductDate %></td>
                <td><%= p.ProductOriginPrice %></td>
                <td><%= p.Quantity %></td>
                <td><%= p.ProductStoreCode %></td>
                <td>
                    <a href="/delete/<%= p._id %>"
                       class="btn btn-danger btn-sm"
                       onclick="return confirm('Delete this?')">
                       Delete
                    </a>
                </td>
            </tr>
        <% }) %>
    </tbody>
</table>

</body>
</html>
