<!DOCTYPE html>
<html>
<head>
    <title>Add Product</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="p-4">
    <h1>Add New Product</h1>

    <form method="POST" action="/web/add">
        <input class="form-control my-2" name="ProductCode" placeholder="Product Code">
        <input class="form-control my-2" name="ProductName" placeholder="Product Name">
        <input class="form-control my-2" name="ProductDate" placeholder="Product Date">
        <input class="form-control my-2" name="ProductOriginPrice" placeholder="Origin Price">
        <input class="form-control my-2" name="Quantity" placeholder="Quantity">
        <input class="form-control my-2" name="ProductStoreCode" placeholder="Store Code">
        <button class="btn btn-success">Insert</button>
    </form>
</body>
</html>
