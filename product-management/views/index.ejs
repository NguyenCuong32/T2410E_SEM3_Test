<!DOCTYPE html>
<html>
<head>
    <title>Product List</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="p-4">
    <h1>Product List</h1>

    <a class="btn btn-primary my-3" href="/web/add">Add Product</a>

    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Code</th><th>Name</th><th>Date</th><th>Price</th>
                <th>Qty</th><th>Store</th><th>Action</th>
            </tr>
        </thead>
        <tbody>
            <% products.forEach(p => { %>
                <tr>
                    <td><%= p.ProductCode %></td>
                    <td><%= p.ProductName %></td>
                    <td><%= p.ProductDate %></td>
                    <td><%= p.ProductOriginPrice %></td>
                    <td><%= p.Quantity %></td>
                    <td><%= p.ProductStoreCode %></td>
                    <td>
                        <a href="/web/delete/<%= p.ProductCode %>" class="btn btn-danger btn-sm">Delete</a>
                    </td>
                </tr>
            <% }) %>
        </tbody>
    </table>

</body>
</html>
