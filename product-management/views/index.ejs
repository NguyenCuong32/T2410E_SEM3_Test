<h1 class="my-4 text-center">Danh sách sản phẩm</h1>
<a href="/add" class="btn btn-success mb-3">+ Thêm sản phẩm mới</a>

<% if (Object.keys(grouped).length === 0) { %>
  <p>Chưa có sản phẩm nào.</p>
<% } else { %>
  <% Object.keys(grouped).sort((a,b)=>b.localeCompare(a)).forEach(storeCode => { %>
    <h3 class="mt-4 text-primary">Kho: <%= storeCode %></h3>
    <div class="table-responsive">
      <table class="table table-striped table-hover">
        <thead class="table-dark">
          <tr>
            <th>Mã SP</th>
            <th>Tên sản phẩm</th>
            <th>Ngày nhập</th>
            <th>Giá gốc</th>
            <th>Số lượng</th>
            <th>Hành động</th>
          </tr>
        </thead>
        <tbody>
          <% grouped[storeCode].sort((a,b)=>b.ProductOriginPrice - a.ProductOriginPrice).forEach(p => { %>
            <tr>
              <td><%= p.ProductCode %></td>
              <td><%= p.ProductName %></td>
              <td><%= new Date(p.ProductDate).toLocaleDateString('vi-VN') %></td>
              <td><%= p.ProductOriginPrice.toLocaleString('vi-VN') %></td>
              <td><%= p.Quantity %></td>
              <td>
                <a href="/delete/<%= p._id %>" class="btn btn-danger btn-sm" 
                   onclick="return confirm('Xóa sản phẩm này?')">Xóa</a>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% }) %>
<% } %>