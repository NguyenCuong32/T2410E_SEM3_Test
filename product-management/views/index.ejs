<!DOCTYPE html>
<html>
<head>
    <title>Product Management</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
</head>
<body class="container mt-5">

<h1>Product List</h1>

<!-- Insert product form -->
<form action="/products" method="POST" class="mb-4 row g-2">
    <div class="col">
        <input type="text" name="ProductCode" placeholder="Product Code" class="form-control" required>
    </div>
    <div class="col">
        <input type="text" name="ProductName" placeholder="Product Name" class="form-control" required>
    </div>
    <div class="col">
        <input type="date" name="ProductDate" class="form-control" required>
    </div>
    <div class="col">
        <input type="number" name="ProductOriginPrice" placeholder="Origin Price" class="form-control" required>
    </div>
    <div class="col">
        <input type="number" name="Quantity" placeholder="Quantity" class="form-control" required>
    </div>
    <div class="col">
        <input type="text" name="ProductStoreCode" placeholder="Store Code" class="form-control" required>
    </div>
    <div class="col">
        <button class="btn btn-primary w-100">Add Product</button>
    </div>
</form>

<!-- Product table -->
<table class="table table-bordered">
    <thead>
        <tr>
            <th>Code</th>
            <th>Name</th>
            <th>Date</th>
            <th>Price</th>
            <th>Quantity</th>
            <th>Store</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        <% products.forEach(product => { %>
        <tr>
            <td><%= product.ProductCode %></td>
            <td><%= product.ProductName %></td>
            <td><%= product.ProductDate.toISOString().split('T')[0] %></td>
            <td><%= product.ProductOriginPrice.toLocaleString() %></td>
            <td><%= product.Quantity %></td>
            <td><%= product.ProductStoreCode %></td>
            <td>
                <form action="/products/<%= product._id %>/delete?_method=DELETE" method="POST">
                    <button class="btn btn-danger btn-sm">Delete</button>
                </form>
            </td>
        </tr>
        <% }) %>
    </tbody>
</table>

</body>
</html>
