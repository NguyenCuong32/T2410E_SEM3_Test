@model IEnumerable<ComicSystem.Models.ComicBook>

@{
    ViewData["Title"] = "Comic Books";
}

<h1>Comic Books</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Create New</a>
</p>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Title</th>
            <th>Author</th>
            <th>Price Per Day</th>
            <th style="width:180px;">Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Title</td>
                <td>@item.Author</td>
                <td>@item.PricePerDay</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.ComicBookId">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.ComicBookId">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.ComicBookId">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
