@model List<ComicSystem.ViewModels.RentalReportRowVM>

<h1>Rental Report</h1>

<form method="post" class="row g-2 mb-3">
    <div class="col-md-4">
        <label class="form-label">Start date</label>
        <input class="form-control" type="date" name="startDate" required />
    </div>
    <div class="col-md-4">
        <label class="form-label">End date</label>
        <input class="form-control" type="date" name="endDate" required />
    </div>
    <div class="col-md-4 d-flex align-items-end">
        <button class="btn btn-primary" type="submit">View</button>
    </div>
</form>

@if (Model != null)
{
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>No</th>
                <th>Book name</th>
                <th>Rental date</th>
                <th>Return date</th>
                <th>Customer name</th>
                <th>Quantity</th>
            </tr>
        </thead>
        <tbody>
            @for (int i = 0; i < Model.Count; i++)
            {
                <tr>
                    <td>@(i + 1)</td>
                    <td>@Model[i].BookName</td>
                    <td>@Model[i].RentalDate.ToString("dd/MM/yyyy")</td>
                    <td>@Model[i].ReturnDate.ToString("dd/MM/yyyy")</td>
                    <td>@Model[i].CustomerName</td>
                    <td>@Model[i].Quantity</td>
                </tr>
            }
        </tbody>
    </table>
}
