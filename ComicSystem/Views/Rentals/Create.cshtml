@model ComicSystem.ViewModels.RentalCreateVM
@{
    ViewData["Title"] = "Create Rental";
}

<h1>Create Rental</h1>

<form asp-action="Create" method="post">
    <div class="mb-3">
        <label class="form-label">Customer</label>
        <select asp-for="CustomerId" class="form-select" asp-items="ViewBag.Customers"></select>
    </div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label class="form-label">Rental Date</label>
            <input asp-for="RentalDate" class="form-control" type="date" />
        </div>
        <div class="col-md-6 mb-3">
            <label class="form-label">Return Date</label>
            <input asp-for="ReturnDate" class="form-control" type="date" />
        </div>
    </div>

    <hr />
    <h4>Books</h4>

    <table class="table table-bordered" id="itemsTable">
        <thead>
            <tr>
                <th>Comic</th>
                <th style="width:120px;">Qty</th>
                <th style="width:160px;">Price/Day</th>
                <th style="width:90px;"></th>
            </tr>
        </thead>
        <tbody>
            @for (int i = 0; i < Model.Items.Count; i++)
            {
                <tr>
                    <td>
                        <select class="form-select" name="Items[@i].ComicBookId" asp-items="ViewBag.ComicBooks"></select>
                    </td>
                    <td>
                        <input class="form-control" type="number" min="1" name="Items[@i].Quantity" value="@Model.Items[i].Quantity" />
                    </td>
                    <td>
                        <input class="form-control" type="number" step="0.01" min="0" name="Items[@i].PricePerDay" value="@Model.Items[i].PricePerDay" />
                    </td>
                    <td>
                        <button type="button" class="btn btn-outline-danger btn-sm" onclick="removeRow(this)">X</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <button type="button" class="btn btn-secondary" onclick="addRow()">+ Add book</button>

    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-action="Index" class="btn btn-link">Back</a>
    </div>
</form>

@section Scripts {
    <script>
        let rowIndex = @Model.Items.Count;

        function addRow() {
          const tbody = document.querySelector("#itemsTable tbody");
          const tr = document.createElement("tr");

          const optionsHtml = document.querySelector("#itemsTable tbody tr select").innerHTML;

          tr.innerHTML = `
            <td><select class="form-select" name="Items[${rowIndex}].ComicBookId">${optionsHtml}</select></td>
            <td><input class="form-control" type="number" min="1" name="Items[${rowIndex}].Quantity" value="1" /></td>
            <td><input class="form-control" type="number" step="0.01" min="0" name="Items[${rowIndex}].PricePerDay" value="0" /></td>
            <td><button type="button" class="btn btn-outline-danger btn-sm" onclick="removeRow(this)">X</button></td>
          `;
          tbody.appendChild(tr);
          rowIndex++;
        }

        function removeRow(btn) {
          btn.closest("tr").remove();
        }
    </script>
}
