@model ComicSystem.Models.ViewModels.RentalCreateVM

<h2>Rent Comic Book</h2>

<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()

    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="form-group">
        <label>Customer</label>
        <select asp-for="CustomerID" asp-items="ViewBag.Customers" class="form-control"></select>
        <span asp-validation-for="CustomerID" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label>Comic Book</label>
        <select asp-for="ComicBookID" asp-items="ViewBag.ComicBooks" class="form-control"></select>
        <span asp-validation-for="ComicBookID" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label>Quantity</label>
        <input asp-for="Quantity" class="form-control" />
        <span asp-validation-for="Quantity" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label>Rental Date</label>
        <input asp-for="RentalDate" type="date" class="form-control" />
        <span asp-validation-for="RentalDate" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label>Return Date</label>
        <input asp-for="ReturnDate" type="date" class="form-control" />
        <span asp-validation-for="ReturnDate" class="text-danger"></span>
    </div>

    <br />

    <button type="submit" class="btn btn-primary">Rent</button>
</form>
