@model IEnumerable<dynamic>

@{
    ViewData["Title"] = "Rental Report";
    int stt = 1;
}

<h1 class="text-center">Rental Report</h1>

<hr />

<div class="card mb-4">
    <div class="card-body">
        <form asp-action="RentalReport" method="get" class="row g-3">
            <div class="col-md-4">
                <label class="form-label">Start Date</label>
                <input type="date" name="startDate" class="form-control" />
            </div>
            <div class="col-md-4">
                <label class="form-label">End Date</label>
                <input type="date" name="endDate" class="form-control" />
            </div>
            <div class="col-md-4 d-flex align-items-end">
                <button type="submit" class="btn btn-primary w-100">Filter</button>
            </div>
        </form>
    </div>
</div>

<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>No</th>
            <th>Book Name</th>
            <th>Rental Date</th>
            <th>Return Date</th>
            <th>Customer Name</th>
            <th>Quantity</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <tr>
                    <td>@(stt++)</td>
                    <td>@item.BookName</td>
                    <td>@item.RentalDate.ToString("dd/MM/yyyy")</td>
                    <td>@item.ReturnDate.ToString("dd/MM/yyyy")</td>
                    <td>@item.CustomerName</td>
                    <td>@item.Quantity</td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="6" class="text-center">No records found.</td>
            </tr>
        }
    </tbody>
</table>

<div class="mt-3">
    <a asp-action="Index" class="btn btn-secondary">Back to Customers</a>
</div>