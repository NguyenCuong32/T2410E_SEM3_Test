@model ComicSystem.Models.ComicBook

@{
    ViewData["Title"] = "Delete Comic Book";
}

<h1>Delete Comic Book</h1>

<h3>Are you sure you want to delete this?</h3>
<div>
    <hr />
    <dl class="row">
        <dt class = "col-sm-3">
            @Html.DisplayNameFor(model => model.Title)
        </dt>
        <dd class = "col-sm-9">
            @Html.DisplayFor(model => model.Title)
        </dd>
        <dt class = "col-sm-3">
            @Html.DisplayNameFor(model => model.Author)
        </dt>
        <dd class = "col-sm-9">
            @Html.DisplayFor(model => model.Author)
        </dd>
        <dt class = "col-sm-3">
            @Html.DisplayNameFor(model => model.PricePerDay)
        </dt>
        <dd class = "col-sm-9">
            @Html.DisplayFor(model => model.PricePerDay)
        </dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="ComicBookID" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </form>
</div>
