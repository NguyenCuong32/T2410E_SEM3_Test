@model IEnumerable<ComicSystem.DTOs.RentalReportDto>

@{
    ViewData["Title"] = "Rental Report Result";
    var filter = ViewBag.Filter as ComicSystem.DTOs.RentalReportFilterDto;
}

<h1>Rental Report Result</h1>

@if (filter != null && (filter.StartDate.HasValue || filter.EndDate.HasValue))
{
    <div class="alert alert-info mb-3">
        <strong>Report Period:</strong>
        @if (filter.StartDate.HasValue && filter.EndDate.HasValue)
        {
            <span>From @filter.StartDate.Value.ToString("dd/MM/yyyy") to @filter.EndDate.Value.ToString("dd/MM/yyyy")</span>
        }
        else if (filter.StartDate.HasValue)
        {
            <span>From @filter.StartDate.Value.ToString("dd/MM/yyyy") onwards</span>
        }
        else if (filter.EndDate.HasValue)
        {
            <span>Up to @filter.EndDate.Value.ToString("dd/MM/yyyy")</span>
        }
    </div>
}

<table class="table table-bordered">
    <thead class="table-light">
        <tr>
            <th>No</th>
            <th>Book name</th>
            <th>Rental date</th>
            <th>Return date</th>
            <th>Customer name</th>
            <th>Quantity</th>
        </tr>
    </thead>
    <tbody>
@if (Model != null && Model.Any())
{
    foreach (var item in Model)
    {
        <tr>
            <td>@item.No</td>
            <td>@item.BookName</td>
            <td>@item.RentalDate.ToString("dd/MM/yyyy")</td>
            <td>@(item.ReturnDate.HasValue ? item.ReturnDate.Value.ToString("dd/MM/yyyy") : "-")</td>
            <td>@item.CustomerName</td>
            <td>@item.Quantity</td>
        </tr>
    }
}
else
{
    <tr>
        <td colspan="6" class="text-center text-muted">No rentals found for the selected period.</td>
    </tr>
}
    </tbody>
</table>

<div class="mt-3">
    <a asp-action="Report" class="btn btn-primary">New Report</a>
    <a asp-action="Index" class="btn btn-secondary">Back to Rentals</a>
</div>
