<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Products</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>

<body class="bg-light">

<nav class="navbar navbar-dark bg-dark mb-4">
  <div class="container">
    <a href="/products" class="navbar-brand">Product Manager</a>
  </div>
</nav>

<div class="container">
  <div class="row">

    <!-- FORM -->
    <div class="col-md-4">
      <div class="card p-3 mb-4">
        <h5>Add Product</h5>

        <form method="POST" action="/products">
          <input class="form-control mb-2" name="ProductCode" placeholder="Code" required />
          <input class="form-control mb-2" name="ProductName" placeholder="Name" required />
          <input class="form-control mb-2" type="date" name="ProductDate" required />
          <input class="form-control mb-2" type="number" name="ProductOriginPrice" placeholder="Price" required />
          <input class="form-control mb-2" type="number" name="Quantity" placeholder="Quantity" required />
          <input class="form-control mb-2" name="ProductStoreCode" placeholder="Store Code" required />

          <button class="btn btn-primary w-100">Insert</button>
        </form>
      </div>
    </div>

    <!-- LIST -->
    <div class="col-md-8">
      <h5>Product List 
        <small class="text-muted">(StoreCode ASC – Price DESC)</small>
      </h5>

      <table class="table table-bordered table-striped mt-3">
        <thead class="table-dark">
          <tr>
            <th>#</th><th>Code</th><th>Name</th><th>Date</th>
            <th>Price</th><th>Qty</th><th>Store</th><th></th>
          </tr>
        </thead>

        <tbody>
          <% if (products.length === 0) { %>
            <tr><td colspan="8" class="text-center">No products</td></tr>
          <% } %>

          <% products.forEach((p,i) => { %>
            <tr>
              <td><%= i+1 %></td>
              <td><%= p.ProductCode %></td>
              <td><%= p.ProductName %></td>
              <td><%= p.ProductDate.toISOString().substring(0,10) %></td>
              <td><%= p.ProductOriginPrice %></td>
              <td><%= p.Quantity %></td>
              <td><%= p.ProductStoreCode %></td>
              <td>
                <form action="/products/<%= p._id %>/delete" method="POST">
                  <button class="btn btn-danger btn-sm">X</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>

      </table>
    </div>

  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
