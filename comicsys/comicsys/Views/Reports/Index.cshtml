@model IEnumerable<ComicSystem.Models.ReportViewModel>

<h1>Báo cáo thuê sách</h1>

<form asp-action="Index" method="post">
    <div class="form-group">
        <label>Ngày bắt đầu</label>
        <input type="date" name="startDate" class="form-control" />
    </div>
    <div class="form-group">
        <label>Ngày kết thúc</label>
        <input type="date" name="endDate" class="form-control" />
    </div>
    <input type="submit" value="Tạo báo cáo" class="btn btn-primary" />
</form>

@if (Model.Any())
{
    <table class="table">
        <thead>
            <tr>
                <th>No</th>
                <th>Book name</th>
                <th>Rental date</th>
                <th>Return date</th>
                <th>Customer name</th>
                <th>Quantity</th>
            </tr>
        </thead>
        <tbody>
            @{
                int no = 1;
            }
            @foreach (var item in Model)
            {
                <tr>
                    <td>@no</td>
                    <td>@item.BookName</td>
                    <td>@item.RentalDate.ToString("dd/MM/yyyy")</td>
                    <td>@item.ReturnDate.ToString("dd/MM/yyyy")</td>
                    <td>@item.CustomerName</td>
                    <td>@item.Quantity</td>
                </tr>
                no++;
            }
        </tbody>
    </table>
}