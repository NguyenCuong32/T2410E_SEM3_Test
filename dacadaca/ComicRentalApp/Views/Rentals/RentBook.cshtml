@model ComicRentalApp.Models.Rental
@{
    ViewData["Title"] = "Rent Book";
}

<h1>Rent a Comic Book</h1>

<form method="post">
    <div class="form-group">
        <label for="RentalDate">Rental Date</label>
        <input type="date" class="form-control" id="RentalDate" name="RentalDate" required />
    </div>

    <div class="form-group">
        <label for="ReturnDate">Return Date</label>
        <input type="date" class="form-control" id="ReturnDate" name="ReturnDate" required />
    </div>

    <div class="form-group">
        <label for="ComicBook">Comic Book</label>
        <select class="form-control" id="ComicBook" name="ComicBookId" required>
            <option value="">Select a Comic Book</option>
            @foreach (var comic in ViewBag.ComicBooks as List<ComicRentalApp.Models.ComicBook>)
            {
                <option value="@comic.Id">@comic.Title</option>
            }
        </select>
    </div>

    <div class="form-group">
        <label for="Quantity">Quantity</label>
        <input type="number" class="form-control" id="Quantity" name="Quantity" required />
    </div>

    <div class="form-group">
        <label for="PricePerDay">Price Per Day</label>
        <input type="number" class="form-control" id="PricePerDay" name="PricePerDay" step="0.01" required />
    </div>

    <button type="submit" class="btn btn-primary">Rent Comic Book</button>
</form>

<a href="@Url.Action("Index", "Home")" class="btn btn-secondary">Back to Home</a>
