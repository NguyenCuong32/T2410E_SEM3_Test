<!DOCTYPE html>
<html>
<head>
    <title>Add Product</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">
</head>

<body class="bg-light">

    <nav class="navbar navbar-dark bg-primary shadow">
        <div class="container">
            <span class="navbar-brand fw-bold">Add New Product</span>
        </div>
    </nav>

    <div class="container mt-4">

        <div class="card shadow-sm p-4">

            <h4 class="mb-3 text-primary">Enter Product Information</h4>

            <form action="/insert" method="POST">

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Product Code</label>
                        <input class="form-control" name="ProductCode" required>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Product Name</label>
                        <input class="form-control" name="ProductName">
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Product Date</label>
                        <input class="form-control" name="ProductDate" placeholder="dd/mm/yyyy">
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Origin Price</label>
                        <input type="number" class="form-control" name="ProductOriginPrice">
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Quantity</label>
                        <input type="number" class="form-control" name="Quantity">
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Store Code</label>
                        <input class="form-control" name="ProductStoreCode">
                    </div>
                </div>

                <button class="btn btn-primary">
                    <i class="bi bi-save"></i> Save Product
                </button>

                <a href="/" class="btn btn-secondary ms-2">
                    <i class="bi bi-arrow-left"></i> Back
                </a>

            </form>

        </div>

    </div>

</body>
</html>
