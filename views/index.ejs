<!DOCTYPE html>
<html lang="vi">
<head>
  <link rel="stylesheet" href="/css/style.css">
  <meta charset="UTF-8" />
  <title>Product Management</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap/dist/css/bootstrap.min.css">
</head>
<body class="container py-4">

  <h1 class="mb-4">Danh sách sản phẩm</h1>

  <table class="table table-striped table-bordered">
    <thead class="table-light">
      <tr>
        <th>Code</th>
        <th>Name</th>
        <th>Date</th>
        <th>Origin Price</th>
        <th>Quantity</th>
        <th>Store Code</th>
        <th>Action</th>
      </tr>
    </thead>
    <tbody>
      <% if (products && products.length) { %>
        <% products.forEach(p => { %>
          <tr>
            <td><%= p.ProductCode %></td>
            <td><%= p.ProductName %></td>
            <td><%= p.ProductDate %></td>
            <td><%= p.ProductOriginPrice.toLocaleString('vi-VN') %></td>
            <td><%= p.Quantity %></td>
            <td><%= p.ProductStoreCode %></td>
            <td>
              <form action="/delete/<%= p.ProductCode %>" method="POST" onsubmit="return confirm('Xóa sản phẩm này?')">
                <button class="btn btn-sm btn-danger">Delete</button>
              </form>
            </td>
          </tr>
        <% }) %>
      <% } else { %>
        <tr><td colspan="7" class="text-center">Không có sản phẩm</td></tr>
      <% } %>
    </tbody>
  </table>

  <hr class="my-4">

  <h2 class="mb-3">Thêm sản phẩm</h2>
  <form action="/add" method="POST" class="row g-3">
    <div class="col-md-2">
      <label class="form-label">ProductCode</label>
      <input type="text" name="ProductCode" class="form-control" required />
    </div>
    <div class="col-md-3">
      <label class="form-label">ProductName</label>
      <input type="text" name="ProductName" class="form-control" required />
    </div>
    <div class="col-md-2">
      <label class="form-label">ProductDate</label>
      <input type="text" name="ProductDate" class="form-control" placeholder="dd/MM/yyyy" required />
    </div>
    <div class="col-md-2">
      <label class="form-label">Origin Price</label>
      <input type="number" name="ProductOriginPrice" class="form-control" required />
    </div>
    <div class="col-md-1">
      <label class="form-label">Quantity</label>
      <input type="number" name="Quantity" class="form-control" required />
    </div>
    <div class="col-md-2">
      <label class="form-label">Store Code</label>
      <input type="text" name="ProductStoreCode" class="form-control" required />
    </div>
    <div class="col-12">
      <button class="btn btn-primary">Add</button>
    </div>
  </form>
<script src="/js/script.js"></script>
</body>
</html>