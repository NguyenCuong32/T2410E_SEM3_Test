@model Customer

<h2>Customer Register</h2>

<form asp-action="Create" method="post">
    <div>
        <label>Full Name</label>
        <input asp-for="FullName" />
    </div>

    <div>
        <label>Phone Number</label>
        <input asp-for="PhoneNumber" />
    </div>

    <br />
    <button type="submit">Register</button>
</form>
